APP_NAME=SmartAdvisor
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
SUPABASE_URL=
SUPABASE_KEY=

# Conversational Assistant Parser Configuration
CONVERSATIONAL_PARSER_MODE=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=5.0

# RAG v0 defaults to a deterministic source-excerpt fallback. Set to gemini to
# use the same GEMINI_API_KEY, GEMINI_MODEL, and timeout settings above.
RAG_GENERATION_MODE=fallback
RAG_CORPUS_PATH=data/rag/local-corpus.json

# Controlled catalog fetch-on-miss is opt-in and also requires an initialized
# persistent RAG_OPERATIONAL_ROOT. Leave disabled for normal/offline use.
RAG_CATALOG_ACQUISITION_ENABLED=false
RAG_CATALOG_ACQUISITION_ROOT=data/course_descriptions
# RAG_OPERATIONAL_ROOT=data/rag/operational

# Exact-mapping syllabus acquisition is independently opt-in. It requires the
# optional Playwright Python package and an existing supported Chrome executable.
RAG_SYLLABUS_ACQUISITION_ENABLED=false
RAG_SYLLABUS_ACQUISITION_ROOT=data/syllabi
# RAG_SYLLABUS_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
