APP_NAME=SmartAdvisor
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
SUPABASE_URL=
SUPABASE_KEY=

# Conversational Assistant Parser Configuration
CONVERSATIONAL_PARSER_MODE=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=5.0

# Browser-retained evidence. Configure a long random value in each deployed
# environment to permit validated reuse across backend restarts.
SESSION_EVIDENCE_SIGNING_KEY=
SYLLABUS_ACQUISITION_ENABLED=false
ACQUISITION_BROWSER_MODE=headed
ACQUISITION_TIMEOUT_SECONDS=20
RENDER_STARTUP_BROWSER_SMOKE=false
