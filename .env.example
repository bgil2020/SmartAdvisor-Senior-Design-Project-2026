APP_NAME=SmartAdvisor
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
SMARTADVISOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SMARTADVISOR_SERVE_FRONTEND=false
SUPABASE_URL=
SUPABASE_KEY=

# Conversational Assistant Parser Configuration
CONVERSATIONAL_PARSER_MODE=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=5.0
GEMINI_MAX_OUTPUT_TOKENS=512
# Optional fail-closed provider-call budget for explicitly approved live tests.
GEMINI_TEST_REQUEST_BUDGET=

# Optional OpenRouter alternative for grounded answer generation. Leave
# RAG_GENERATION_MODE=fallback or gemini unless this provider is verified.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=10
OPENROUTER_MAX_OUTPUT_TOKENS=512
OPENROUTER_TEST_REQUEST_BUDGET=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=SmartAdvisor

# Browser-retained evidence. Configure a long random value in each deployed
# environment to permit validated reuse across backend restarts.
SESSION_EVIDENCE_SIGNING_KEY=
CATALOG_ACQUISITION_ENABLED=false
CATALOG_ACQUISITION_TIMEOUT_SECONDS=10
CATALOG_ACQUISITION_MAX_BYTES=2097152
SYLLABUS_ACQUISITION_ENABLED=false
ACQUISITION_BROWSER_MODE=headed
ACQUISITION_TIMEOUT_SECONDS=20
ACQUISITION_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
ACQUISITION_READINESS_TEXT=Course Evaluation Method
ACQUISITION_MAX_RENDERED_HTML_BYTES=2097152
RENDER_STARTUP_BROWSER_SMOKE=false

# RAG v0 defaults to a deterministic source-excerpt fallback. Supported live
# provider modes are gemini and openrouter; each requires its matching key.
RAG_GENERATION_MODE=fallback
RAG_CORPUS_PATH=data/rag/local-corpus.json
