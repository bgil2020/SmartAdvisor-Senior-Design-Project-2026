APP_NAME=SmartAdvisor
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
SMARTADVISOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SMARTADVISOR_SERVE_FRONTEND=false
SUPABASE_URL=
SUPABASE_KEY=

# Conversational Assistant Parser Configuration
CONVERSATIONAL_PARSER_MODE=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=5.0

# Browser-retained evidence. Configure a long random value in each deployed
# environment to permit validated reuse across backend restarts.
SESSION_EVIDENCE_SIGNING_KEY=
CATALOG_ACQUISITION_ENABLED=false
CATALOG_ACQUISITION_TIMEOUT_SECONDS=10
CATALOG_ACQUISITION_MAX_BYTES=2097152
SYLLABUS_ACQUISITION_ENABLED=false
ACQUISITION_BROWSER_MODE=headed
ACQUISITION_TIMEOUT_SECONDS=20
RENDER_STARTUP_BROWSER_SMOKE=false

# RAG v0 defaults to a deterministic source-excerpt fallback. Set to gemini to
# use the same GEMINI_API_KEY, GEMINI_MODEL, and timeout settings above.
RAG_GENERATION_MODE=fallback
RAG_CORPUS_PATH=data/rag/local-corpus.json
