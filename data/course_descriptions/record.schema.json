{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smartadvisor:course-description-record:1.0",
  "title": "SmartAdvisor course-description record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "record_version", "record_category", "course_code",
    "course_scope", "term_scope", "section_scope", "title", "description",
    "prerequisite_text", "exact_source_text", "source", "fetched_at",
    "collection_method", "raw_evidence_ref", "raw_sha256", "content_sha256",
    "parser_version", "schema_version", "unknowns", "limitations"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^fau-catalog:course_description:[a-z]{3}[0-9]{4}[a-z]?$"},
    "record_version": {"type": "integer", "minimum": 1},
    "record_category": {"const": "course_description"},
    "course_code": {"type": "string", "pattern": "^[A-Z]{3}[0-9]{4}[A-Z]?$"},
    "course_scope": {"type": "object", "required": ["course_code"], "properties": {"course_code": {"type": "string"}}, "additionalProperties": false},
    "term_scope": {"type": ["object", "null"]},
    "section_scope": {"type": ["object", "null"]},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "prerequisite_text": {"type": ["string", "null"]},
    "exact_source_text": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["source_id", "title", "publisher", "url", "locator", "catalog_edition", "effective_scope"],
      "properties": {
        "source_id": {"type": "string"}, "title": {"type": "string"},
        "publisher": {"type": "string"}, "url": {"type": "string", "format": "uri"},
        "locator": {"type": "object"}, "catalog_edition": {"type": ["string", "null"]},
        "effective_scope": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "fetched_at": {"type": "string", "format": "date-time"},
    "collection_method": {"type": "string"},
    "raw_evidence_ref": {"type": "string"},
    "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser_version": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "unknowns": {"type": "object", "additionalProperties": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
